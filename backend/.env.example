NODE_ENV=development
PORT=5000
DATA_PROVIDER=local
HEART_RECOVER_MINUTES=15
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=7d

# Azure SQL (optional - only required when DATA_PROVIDER=azure)
AZURE_SQL_ENABLED=false
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# Azure Blob Storage (optional)
AZURE_STORAGE_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=story-assets

# Azure Cosmos DB (optional)
AZURE_COSMOS_ENABLED=false
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=storyverse
